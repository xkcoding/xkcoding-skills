# md-image-rehost OSS config.
# Copy to ~/.config/md-image-rehost.env (or <skill-dir>/.env) and fill in.
# The script auto-loads it; real environment variables still take precedence.
# Keep this file private — it holds credentials. Do NOT commit it.

OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
OSS_BUCKET=your-bucket
OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com   # alternative to OSS_REGION
OSS_CDN_BASE_URL=https://cdn.example.com
# OSS_KEY_PREFIX=               # optional; unset = derive from project name
# OSS_PROCESS_STYLE=tag_compress # optional; appended as ?x-oss-process=style/<name>
