#!/usr/bin/env python3
"""Score the case set: how much of the spec it covers, minus what it repeats.

    score = features covered × 1  +  feature pairs covered × 0.05  -  redundant cases × 2

A case counts for nothing unless its `expected` matches what the reference parser produces:
a case that asserts the wrong thing is worse than no case at all, because the `impl` subject
would then be chasing it. Which features a case exercises is decided by the detectors, never
by what the case claims, so coverage cannot be inflated by what a case says about itself.

A case that exercises more than MAX_FEATURES features counts for nothing either. Without that
ceiling one enormous query covers most of the pairs at once, which is both a worse test suite
(a failure tells you nothing about which rule broke) and a scorer that saturates in a single
round. The ceiling is what makes this research take many rounds rather than one.

Run from the repository root. Prints one JSON object.
"""

import itertools
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import ref_qs  # noqa: E402  - the reference lives beside this scorer, inside the locked directory

VERSION = "1.0.0"
CASE_DIR = "cases"
MAX_FEATURES = 4


def load_cases():
    out = []
    for name in sorted(os.listdir(CASE_DIR)) if os.path.isdir(CASE_DIR) else []:
        if not name.endswith(".json"):
            continue
        path = os.path.join(CASE_DIR, name)
        try:
            with open(path, encoding="utf-8") as fh:
                data = json.load(fh)
        except Exception as exc:  # noqa: BLE001 - an unreadable case is a broken case
            out.append({"path": path, "error": "not valid JSON: {}".format(exc)})
            continue
        if not isinstance(data, dict) or not isinstance(data.get("input"), str) or \
                "expected" not in data:
            out.append({"path": path, "error": "needs an \"input\" string and an \"expected\" value"})
            continue
        out.append({"path": path, "input": data["input"], "expected": data["expected"]})
    return out


def main():
    cases = load_cases()
    valid, invalid, overloaded = [], [], []
    for case in cases:
        if case.get("error"):
            invalid.append("{}: {}".format(case["path"], case["error"]))
            continue
        truth = ref_qs.parse(case["input"])
        if truth != case["expected"]:
            invalid.append("{}: expected {} but the rules give {}".format(
                case["path"], json.dumps(case["expected"], ensure_ascii=False, sort_keys=True),
                json.dumps(truth, ensure_ascii=False, sort_keys=True)))
            continue
        case["features"] = ref_qs.detect(case["input"])
        if len(case["features"]) > MAX_FEATURES:
            overloaded.append("{}: exercises {} features at once ({}); a case may exercise at "
                              "most {}".format(case["path"], len(case["features"]),
                                               ", ".join(sorted(case["features"])), MAX_FEATURES))
            continue
        valid.append(case)

    covered = set()
    pairs = set()
    shapes = {}
    for case in valid:
        covered |= case["features"]
        pairs |= set(frozenset(p) for p in itertools.combinations(sorted(case["features"]), 2))
        key = frozenset(case["features"])
        shapes.setdefault(key, []).append(case["path"])
    redundant = [p for paths in shapes.values() for p in paths[1:]]

    all_pairs = set(frozenset(p) for p in itertools.combinations(ref_qs.FEATURES, 2))
    missing_features = [f for f in ref_qs.FEATURES if f not in covered]
    missing_pairs = sorted(" × ".join(sorted(p)) for p in all_pairs - pairs)

    remaining = ["feature: " + f for f in missing_features]
    remaining += ["pair: " + p for p in missing_pairs[:40]]
    if len(missing_pairs) > 40:
        remaining.append("pair: … {} more pairs".format(len(missing_pairs) - 40))
    remaining += ["invalid: " + msg for msg in invalid]
    remaining += ["overloaded: " + msg for msg in overloaded]
    remaining += ["redundant: {} repeats a feature set already covered".format(p)
                  for p in redundant]

    print(json.dumps({
        "score": round(len(covered) * 1.0 + len(pairs) * 0.05 - len(redundant) * 2.0, 4),
        "version": VERSION,
        "details": {
            "cases": len(cases),
            "valid": len(valid),
            "invalid": len(invalid),
            "overloaded": len(overloaded),
            "redundant": len(redundant),
            "features": "{}/{}".format(len(covered), len(ref_qs.FEATURES)),
            "pairs": "{}/{}".format(len(pairs), len(all_pairs)),
        },
        "remaining": remaining,
    }, ensure_ascii=False))


main()
