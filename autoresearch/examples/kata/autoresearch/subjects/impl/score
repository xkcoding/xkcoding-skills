#!/usr/bin/env python3
"""Score the parser: how many of the case inputs it gets right.

Each case runs in its own subprocess with a two second limit, so that a parser which hangs or
crashes costs one case rather than the whole round. The expected value is recomputed from the
reference rules, not read from the case file: the case set is the agent's own work, and a
scorer that trusted it could be satisfied by weakening the cases instead of fixing the parser.

Run from the repository root. Prints one JSON object.
"""

import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                                "cases"))
import ref_qs  # noqa: E402

VERSION = "1.0.0"
CASE_DIR = "cases"
IMPL = os.path.join("src", "qs.py")
RUNNER = (
    "import json,sys;sys.path.insert(0,'src');import qs;"
    "print(json.dumps(qs.parse(json.loads(sys.argv[1])),ensure_ascii=False,sort_keys=True))"
)


def inputs():
    out = []
    for name in sorted(os.listdir(CASE_DIR)) if os.path.isdir(CASE_DIR) else []:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(CASE_DIR, name), encoding="utf-8") as fh:
                data = json.load(fh)
            if isinstance(data, dict) and isinstance(data.get("input"), str):
                out.append((os.path.join(CASE_DIR, name), data["input"]))
        except Exception:  # noqa: BLE001 - a broken case file is the other subject's problem
            continue
    return out


def run_one(query):
    try:
        p = subprocess.run([sys.executable, "-c", RUNNER, json.dumps(query)],
                           capture_output=True, text=True, timeout=2)
    except subprocess.TimeoutExpired:
        return None, "timed out"
    if p.returncode != 0:
        return None, (p.stderr or "").strip().splitlines()[-1][:160] if p.stderr else "exit {}".format(
            p.returncode)
    try:
        return json.loads(p.stdout), None
    except ValueError:
        return None, "printed something that is not JSON: {}".format((p.stdout or "").strip()[:80])


def main():
    cases = inputs()
    if not os.path.isfile(IMPL):
        print(json.dumps({
            "score": 0.0, "version": VERSION,
            "details": {"cases": len(cases), "passing": 0, "parser": "missing"},
            "remaining": ["{} does not exist yet; it needs a parse(query) -> dict".format(IMPL)],
        }, ensure_ascii=False))
        return

    passing, failing, errors = 0, [], 0
    for path, query in cases:
        want = ref_qs.parse(query)
        got, err = run_one(query)
        if err:
            errors += 1
            failing.append("{} ({!r}): {}".format(path, query, err))
        elif got == want:
            passing += 1
        else:
            failing.append("{} ({!r}): expected {} got {}".format(
                path, query, json.dumps(want, ensure_ascii=False, sort_keys=True),
                json.dumps(got, ensure_ascii=False, sort_keys=True)))

    print(json.dumps({
        "score": float(passing), "version": VERSION,
        "details": {"cases": len(cases), "passing": passing, "failing": len(failing),
                    "errors": errors, "parser": IMPL},
        "remaining": failing[:60] + (["… {} more failing cases".format(len(failing) - 60)]
                                     if len(failing) > 60 else []),
    }, ensure_ascii=False))


main()
