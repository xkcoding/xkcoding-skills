#!/usr/bin/env python3
"""Negative distance from the hidden target: bigger is better, 0 is perfect."""

import json
import os

VERSION = "1.0.0"
HERE = os.path.dirname(os.path.abspath(__file__))

target = json.load(open(os.path.join(HERE, "target.json")))["v"]
vec = json.load(open("vec.json"))["v"]
dev = [abs(a - b) for a, b in zip(vec, target)]
worst = max(range(len(dev)), key=lambda i: dev[i])
dist = sum(d * d for d in dev) ** 0.5
print(json.dumps({
    "score": round(-dist, 4),
    "version": VERSION,
    "details": {"distance": round(dist, 4),
                "worst component": worst,
                "deviation": round(dev[worst], 4)},
    "remaining": ["component {} is off by {}".format(worst, round(target[worst] - vec[worst], 4))]
                 if dist > 0.01 else [],
}))
